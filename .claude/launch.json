{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lofi-web",
      "runtimeExecutable": "web/node_modules/.bin/vite",
      "runtimeArgs": [
        "web",
        "--host",
        "127.0.0.1",
        "--port",
